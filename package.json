{
  "name": "@codegoat-cli/agentrail",
  "version": "0.1.0",
  "description": "macOS sandboxing utilities (dscl user/group management, ACL scoping, child-process re-exec) for CodeGoat CLI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "os": [
    "darwin"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=18.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anhadh3101/agentrail.git"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "tsc",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:watch": "node --watch --import tsx --test \"test/**/*.test.ts\""
  },
  "keywords": [
    "codegoat",
    "sandboxing",
    "macos"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
